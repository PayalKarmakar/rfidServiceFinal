{
  "ConnectionStrings": {
    "PostgreSqlConnection": "Host=localhost;Port=5432;Database=smart_monitoring;Username=postgres;Password=postgres"
  },

  "RfidSettings": {
    "EntryExitGapSeconds": 30,

    "ReaderConnectionRetryDurationMinutes": 10,
    "ReaderConfigReloadIntervalSeconds": 10,
    "ViolationCheckIntervalSeconds": 5,
    "EntryExitCooldownSeconds": 10,

    "InventoryIntervalSeconds": 1, // 1 sec inventory Loop active..
    "ReaderConnectionRetryCount": 5, // retry times when reader is not connected
    "ReaderConnectionRetryIntervalSeconds": 5 // retry timing after ReaderConnectionRetryCount 5 seconds

  },
    "RfidService": {
        "BaseUrl": "http://localhost:64311"
    }
}